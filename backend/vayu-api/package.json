{
  "name": "@medtrack/vayu-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vayu API server — Prisma, webhooks, SSE, HMAC. Holds the shared secret.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio --port 5555"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@medtrack/contracts": "*",
    "@medtrack/crypto": "*",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
