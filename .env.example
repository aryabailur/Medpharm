# MedTrack — environment
# Copy to `.env` and fill in. Never commit `.env`.

# ─── Database ────────────────────────────────────────────────────────────────
# ONE Postgres instance, TWO schemas. Same server, different `schema=` param.
# Local (docker compose up -d):
VAYU_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medtrack?schema=vayu"
DHANVANTARI_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medtrack?schema=dhanvantari"

# Hosted (Neon / Supabase) — swap the host, keep the ?schema= param:
# VAYU_DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/medtrack?schema=vayu&sslmode=require"
# DHANVANTARI_DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/medtrack?schema=dhanvantari&sslmode=require"

# ─── Cross-app contract (ARCHITECTURE.md 5.2) ────────────────────────────────
# Shared HMAC secret. Both apps must hold the SAME value or every signed
# request fails verification. Generate: openssl rand -hex 32
MEDTRACK_SHARED_SECRET="dev-only-change-me-0000000000000000000000000000000000000000000000"

# Where each app reaches the other.
VAYU_BASE_URL="http://localhost:3000"
DHANVANTARI_BASE_URL="http://localhost:3001"

# ─── Nidana (intelligence service) ───────────────────────────────────────────
NIDANA_BASE_URL="http://localhost:8000"
# Every Nidana endpoint has a deterministic TS fallback (ARCHITECTURE.md 3.2).
# Set true to force the fallback path and prove it works before demo day.
NIDANA_FORCE_FALLBACK="false"

# ─── LLM (chatbot + RCA narration, ARCHITECTURE.md 6.3 / 7) ──────────────────
ANTHROPIC_API_KEY=""

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ─── Maps ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=""
# OSRM public demo API — free, no key, no billing (ARCHITECTURE.md 6.5).
OSRM_BASE_URL="https://router.project-osrm.org"
