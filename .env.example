# MedTrack — environment
# Copy to `.env` and fill in. Never commit `.env`.
#
# Port map:
#   3000  vayu-web           (frontend, UI only)
#   3001  dhanvantari-web    (frontend, UI only)
#   4000  vayu-api           (backend — Prisma, HMAC, SSE)
#   4001  dhanvantari-api    (backend — Prisma, HMAC, SSE)
#   8000  nidana             (FastAPI, stateless)
#   5432  postgres

# ═══ FRONTEND (public — these ship in the browser bundle) ════════════════════
# NEXT_PUBLIC_* is readable by anyone who opens devtools.
# NEVER put a secret behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_VAYU_API_URL="http://localhost:4000"
NEXT_PUBLIC_DHANVANTARI_API_URL="http://localhost:4001"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ═══ BACKEND (server-only — never exposed to a browser) ══════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# ONE Postgres instance, TWO schemas. Each API server gets its own connection
# string with a different `schema=` param, and its own Prisma client.
# Set DATABASE_URL per service (each reads plain DATABASE_URL):
#   backend/vayu-api         → ?schema=vayu
#   backend/dhanvantari-api  → ?schema=dhanvantari
VAYU_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medtrack?schema=vayu"
DHANVANTARI_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medtrack?schema=dhanvantari"

# Hosted (Neon / Supabase) — swap the host, keep the ?schema= param:
# VAYU_DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/medtrack?schema=vayu&sslmode=require"

# ─── Cross-app contract (§5.2) ───────────────────────────────────────────────
# Shared HMAC secret. Both API servers must hold the SAME value or every signed
# request fails verification. Generate: openssl rand -hex 32
# This is server-only. It must never reach a browser or a mobile bundle.
MEDTRACK_SHARED_SECRET="dev-only-change-me-0000000000000000000000000000000000000000000000"

# Where each API server reaches the other.
VAYU_API_URL="http://localhost:4000"
DHANVANTARI_API_URL="http://localhost:4001"

# CORS — which frontend origin each API server accepts.
VAYU_WEB_ORIGIN="http://localhost:3000"
DHANVANTARI_WEB_ORIGIN="http://localhost:3001"

# ─── Nidana (intelligence service) ───────────────────────────────────────────
NIDANA_BASE_URL="http://localhost:8000"
# Every Nidana endpoint has a deterministic TS fallback (§3.2).
# Set true to force the fallback path and prove it works before demo day.
NIDANA_FORCE_FALLBACK="false"

# ─── LLM (chatbot + RCA narration, §6.3 / §7) ────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=""

# ─── Maps ────────────────────────────────────────────────────────────────────
# OSRM public demo API — free, no key, no billing (§6.5).
OSRM_BASE_URL="https://router.project-osrm.org"
