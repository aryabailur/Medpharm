# EXPO MOBILE ENVIRONMENT CONFIGURATION
# Copy this file to `.env` in the `mobile` folder.

# Clerk auth publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Backend API endpoints (point this to the local Dhanvantari or Vayu Fastify servers)
# When testing on a physical device, replace `localhost` with your local machine's LAN IP (e.g. 192.168.1.X)
EXPO_PUBLIC_VAYU_API_URL="http://localhost:4000"
EXPO_PUBLIC_DHANVANTARI_API_URL="http://localhost:4001"
